# Copy to .env (git-ignored) and fill in.

# Only used by scripts/check_groq.py for offline prompt testing.
# Inside n8n the key lives in a Header Auth credential, never in the workflow JSON.
GROQ_API_KEY=

# Production webhook URL of the activated n8n workflow, e.g.
# https://<your-instance>.app.n8n.cloud/webhook/arcvault-intake
N8N_WEBHOOK_URL=

# Your unique Webhook.site URL (https://webhook.site/<uuid>). build_workflow.py bakes it
# into the Config node; records are POSTed to <this>/<destination_queue>.
WEBHOOK_SITE_URL=
